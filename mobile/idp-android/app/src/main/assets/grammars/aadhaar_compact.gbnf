root ::= "{\"aadhaar_number\": " num ", \"name\": " nm ", \"dob\": " dt ", \"gender\": " gen "}"
num ::= "\"" [0-9]{4} " " [0-9]{4} " " [0-9]{4} "\"" | "null"
nm ::= "\"" [A-Za-z] [A-Za-z .'-]{1,48} "\"" | "null"
dt ::= "\"" [0-9] [0-9] [-/] [0-9] [0-9] [-/] [0-9] [0-9] [0-9] [0-9] "\"" | "null"
gen ::= "\"M\"" | "\"F\"" | "null"
