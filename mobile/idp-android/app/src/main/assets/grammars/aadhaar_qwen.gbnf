root ::= "{\"aadhaar_number\": " num ", \"name\": " nm ", \"dob\": " dob ", \"gender\": " gen ", \"address_visible\": " av "}"
av ::= "true, \"address\": " adstr ", \"pincode\": " pin | "false, \"address\": null, \"pincode\": null"
adstr ::= "\"" adch{15,350} "\""
num ::= "\"" [0-9] [0-9] [0-9] [0-9] " " [0-9] [0-9] [0-9] [0-9] " " [0-9] [0-9] [0-9] [0-9] "\"" | "null"
nm ::= "\"" [A-Za-z] [A-Za-z .'-]{1,48} "\"" | "null"
dob ::= "\"" [0-3] [0-9] "/" [01] [0-9] "/" [12] [0-9] [0-9] [0-9] "\"" | "null"
gen ::= "\"M\"" | "\"F\"" | "\"O\"" | "null"
adch ::= [A-Za-z0-9 ,.:;/()&'#+-] | "\\n"
pin ::= "\"" [0-9]{6} "\"" | "null"
