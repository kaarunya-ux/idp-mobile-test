{
  "realm": "idp",
  "enabled": true,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      {"name": "ORG_ADMIN"},
      {"name": "MEMBER"},
      {"name": "PLATFORM_ADMIN"}
    ]
  },
  "clients": [
    {
      "clientId": "extraction-service",
      "enabled": true,
      "publicClient": false,
      "secret": "local-extraction-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience ai-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {"included.custom.audience": "ai-gateway", "access.token.claim": "true", "id.token.claim": "false"}
        }
      ]
    },
    {
      "clientId": "conversion-service",
      "enabled": true,
      "publicClient": false,
      "secret": "local-conversion-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience ai-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {"included.custom.audience": "ai-gateway", "access.token.claim": "true", "id.token.claim": "false"}
        }
      ]
    },
    {
      "clientId": "idp-test",
      "name": "Local test tokens for the templates API (stands in for the web and mobile apps)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience idp-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {"included.custom.audience": "idp-api", "access.token.claim": "true", "id.token.claim": "false"}
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {"access.token.claim": "true", "introspection.token.claim": "true"}
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {"claim.name": "roles", "multivalued": "true", "jsonType.label": "String", "access.token.claim": "true"}
        },
        {
          "name": "account id (made-up, one test account)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "account_id",
            "claim.value": "0192f0aa-0000-7000-8000-00000000a001",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "org-admin",
      "enabled": true,
      "email": "org-admin@example.test",
      "emailVerified": true,
      "firstName": "Org",
      "lastName": "Admin",
      "credentials": [{"type": "password", "value": "local-password", "temporary": false}],
      "realmRoles": ["ORG_ADMIN"]
    },
    {
      "username": "member",
      "enabled": true,
      "email": "member@example.test",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Member",
      "credentials": [{"type": "password", "value": "local-password", "temporary": false}],
      "realmRoles": ["MEMBER"]
    },
    {
      "username": "staff-admin",
      "enabled": true,
      "email": "staff-admin@example.test",
      "emailVerified": true,
      "firstName": "Staff",
      "lastName": "Admin",
      "credentials": [{"type": "password", "value": "local-password", "temporary": false}],
      "realmRoles": ["PLATFORM_ADMIN"]
    },
    {
      "username": "service-account-extraction-service",
      "enabled": true,
      "serviceAccountClientId": "extraction-service"
    },
    {
      "username": "service-account-conversion-service",
      "enabled": true,
      "serviceAccountClientId": "conversion-service"
    }
  ]
}
