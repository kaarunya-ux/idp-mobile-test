# Copy to .env (git-ignored) and change only what you need. Every value has a working default for mode B.

# Mode B (default): RabbitMQ, MinIO and Keycloak run in this stack. Mode A (the backend's instances): clear this,
# then fill in the backend's addresses below.
COMPOSE_PROFILES=infra

# This machine's address as other machines reach it (hostname -I). It is the issuer in every local token, so
# set it before the backend team calls the API from their machines; keep localhost when testing alone.
PUBLIC_HOST=localhost

# --- Mode A only: the backend's infrastructure --------------------------------------------------------------
# RABBIT_URL=amqp://user:password@backend-host:5672/vhost
# CELERY_BROKER_URL=amqp://user:password@backend-host:5672/python-tasks   # a vhost of its own is best
# STORAGE_ENDPOINT=http://backend-host:9000
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# TOKEN_ISSUER=http://backend-keycloak:8080/realms/idp
# TOKEN_JWKS_URL=http://backend-keycloak:8080/realms/idp/protocol/openid-connect/certs
# SERVICE_TOKEN_URL=http://backend-keycloak:8080/realms/idp/protocol/openid-connect/token
# EXTRACTION_CLIENT_SECRET=
# CHECK_TOKEN_URL=http://backend-keycloak:8080/realms/idp/protocol/openid-connect/token

# --- AI: the mock answers until the real model server is pointed in -------------------------------------------
# MODEL_BASE_URL=http://10.0.3.66:4000/v1
MOCK_MODEL_LATENCY_MS=300

# --- Other ------------------------------------------------------------------------------------------------
# OCR_MODELS_DIR=./models      # filled by `make models`
LOG_LEVEL=INFO
