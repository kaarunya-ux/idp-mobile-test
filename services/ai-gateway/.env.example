# Copy to .env for local runs (.env is git-ignored). Every variable is described in README.md.
SERVICE_NAME=ai-gateway
ENVIRONMENT=local
LOGGING__LEVEL=INFO
LOGGING__FORMAT=console

MODEL__BASE_URL=http://10.0.3.66:4000/v1
# MODEL__API_KEY=
MODEL__VL_MAX_CONCURRENT=4

# Local values only: real ones come from the platform.
REDIS__URL=redis://localhost:6379/0
STORAGE__ENDPOINT=http://localhost:9000
STORAGE__ACCESS_KEY=local-access-key
STORAGE__SECRET_KEY=local-secret-key

# The token issuer (Keycloak). JSON, because it is a list.
AUTH__ISSUERS=[{"issuer": "http://localhost:8080/realms/idp", "jwks_url": "http://localhost:8080/realms/idp/protocol/openid-connect/certs"}]
