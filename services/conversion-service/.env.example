# Copy to .env for local runs (.env is git-ignored). Every variable is described in README.md.
SERVICE_NAME=conversion-service
ENVIRONMENT=local
LOGGING__LEVEL=INFO
LOGGING__FORMAT=console

# Matches compose.yaml (`make up`), seen from your machine. Local values only: real ones come from the platform.
DB__URL=postgresql+psycopg://conversion:conversion@localhost:5432/conversion_db
RABBIT__URL=amqp://guest:guest@localhost:5672/
CELERY__BROKER_URL=amqp://guest:guest@localhost:5672/
STORAGE__ENDPOINT=http://localhost:9000
STORAGE__ACCESS_KEY=local-access-key
STORAGE__SECRET_KEY=local-secret-key
