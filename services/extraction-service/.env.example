# Copy to .env for local runs (.env is git-ignored). Every variable is described in README.md.
SERVICE_NAME=extraction-service
ENVIRONMENT=local
LOGGING__LEVEL=INFO
LOGGING__FORMAT=console
OCR__MODELS_DIR=/path/to/the/models/folder
OCR__MODELS_FILE=models.yaml
OCR__THREADS=4
OCR__INFERENCE_TIMEOUT=PT60S
OCR__MAX_PIXELS=60000000

# The service processes (intake, workers, relay). Local values only: real ones come from the platform.
DB__URL=postgresql+psycopg://extraction:extraction@localhost:5433/extraction_db
RABBIT__URL=amqp://guest:guest@localhost:5672/
CELERY__BROKER_URL=amqp://guest:guest@localhost:5672/
STORAGE__ENDPOINT=http://localhost:9000
STORAGE__ACCESS_KEY=local-access-key
STORAGE__SECRET_KEY=local-secret-key
# STORAGE__BUCKET_TEMPLATES=idp-templates
# Worker metrics (multiprocess): an empty folder per worker
# PROMETHEUS_MULTIPROC_DIR=/tmp/extraction-metrics
# METRICS__PORT=9100
# The AI fallback for fields OCR can't settle, through ai-gateway (ADR 0006). Unset = off.
# AI_GATEWAY__URL=http://localhost:8002
# SERVICE_AUTH__TOKEN_URL=http://localhost:8080/realms/idp/protocol/openid-connect/token
# SERVICE_AUTH__CLIENT_SECRET=
# Without the gateway, on a laptop only: the model host directly.
# AI_FALLBACK__URL=http://10.0.3.66:8081
# AI_FALLBACK__API_KEY=
# LibreOffice in the workers, for Word, Excel and PowerPoint input (ADR 0008)
# OFFICE__BINARY=soffice
# OFFICE__TIMEOUT=PT60S
