# Every variable the service reads (CFG-05). Copy to .env for local runs; the platform injects them elsewhere (MSV-02).
SERVICE_NAME=idox-conversion-service
ENVIRONMENT=local
LOGGING__LEVEL=INFO
LOGGING__FORMAT=console
# The model server that reads pages. thinking is always sent, never left to the server's default.
MODEL__BASE_URL=http://127.0.0.1:8080
MODEL__THINKING=false
MODEL__REQUEST_TIMEOUT=600
MODEL__MAX_OUTPUT_TOKENS=4000
MODEL__MAX_IMAGE_SIDE_PX=0
MODEL__CONCURRENCY=1
LIMITS__MAX_PAGES=200
LIMITS__MAX_IMAGE_PIXELS=180000000
LIMITS__DOCUMENT_TIMEOUT=120
LIMITS__JOB_ITEM_TIMEOUT=600
CHECKS__MIN_WORD_SHARE=0.95
CHECKS__MIN_WORD_SHARE_OCR=0.85
LAYOUT__MAX_PARAGRAPH_SPACE_PT=36
