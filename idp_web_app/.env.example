# Copy to .env and edit. start.sh loads it.

# Model host (llama-server) to use: mini3 during the model tests.
LLAMA_URL=http://10.0.3.66:8081
# Must match the model host's LLAMA_API_KEY; leave empty if the host has none.
LLAMA_API_KEY=
# Model id sent with each request: leave empty for llama-server; required by mlx_vlm.server
# (its loaded model, e.g. models/Qwen3.5-4B-MLX-4bit).
LLAMA_MODEL=
# Let the model host enforce the JSON schema: true for llama-server; false for mlx_vlm.server, whose
# enforcement breaks the first value. Values are always checked against the schema in the app too.
SEND_SCHEMA=true

# Where this service listens.
HOST=0.0.0.0
PORT=8020

MAX_UPLOAD_MB=15
# Longest image side sent to the model.
EXTRACT_EDGE=1280
# Smaller images are enlarged to this.
MIN_EDGE=768
# Final scale on every image: 1 for Qwen3/3.5 models; 0.875 gives a Qwen2.5-VL model the same token count.
IMAGE_SCALE=1

# Reuse the cached prompt text across requests (keep true).
CACHE_PROMPT=true
