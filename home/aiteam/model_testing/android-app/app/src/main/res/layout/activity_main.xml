<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F6F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VLM Tester"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#17160F" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="VisionPsy-Nano on-device extraction, running fully on this phone"
            android:textSize="13sp"
            android:textColor="#54524A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEVICE, RIGHT NOW"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#8A887D" />

            <TextView
                android:id="@+id/tvStorage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textColor="#17160F"
                android:text="Storage: -- " />

            <TextView
                android:id="@+id/tvModelsSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textColor="#17160F"
                android:text="Models folder: -- " />

            <TextView
                android:id="@+id/tvRamIdle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textColor="#17160F"
                android:text="RAM (device): -- " />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Model"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#8A887D" />
        <Spinner
            android:id="@+id/spinnerModel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vision projector (mmproj)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#8A887D" />
        <Spinner
            android:id="@+id/spinnerMmproj"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Document type"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#8A887D" />
        <Spinner
            android:id="@+id/spinnerDocType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="14dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchGpu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Use GPU (Vulkan) for language model" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Vision encoder (mmproj) always stays on CPU. Off = current CPU-only baseline."
                android:textSize="11sp"
                android:textColor="#8A887D" />

            <TextView
                android:id="@+id/tvThreads"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="CPU threads: 4"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textColor="#17160F" />

            <SeekBar
                android:id="@+id/seekThreads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="7"
                android:progress="3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Applies to both -t and -tb. Default (4) matches this phone's fast cores; going higher pulls in the slow cores too and can be slower overall."
                android:textSize="11sp"
                android:textColor="#8A887D" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchServerMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:checked="false"
                android:text="Persistent server mode (experimental)" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Off = current behaviour: reloads the full model every run. On = keeps the model resident across runs and applies the vision-tile latency fix (~14-16s/field vs ~50-90s), but the first run after changing model/threads/GPU pays one restart cost."
                android:textSize="11sp"
                android:textColor="#8A887D" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchPanFullHighCap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:checked="true"
                android:text="pan_full: 256 image tokens (off = 128)" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="On (default): ~10-15s slower per run, but fixes real misreads found at 128 on clean cards (dropped/transposed letters, a wrong digit). Off = faster, only use once 128 has been re-validated."
                android:textSize="11sp"
                android:textColor="#8A887D" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pick image or PDF" />

        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="#54524A" />

        <!-- Only shown for two-sided document types (e.g. tt_id), toggled in code. -->
        <Button
            android:id="@+id/btnPickBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:text="Pick back-side image" />

        <ImageView
            android:id="@+id/imgPreviewBack"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvFileNameBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="#54524A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRun"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:enabled="false"
                android:text="Run extraction" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:backgroundTint="#C1392B"
                android:textColor="#FFFFFF"
                android:text="STOP" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/statsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE ON-DEVICE STATS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#8A887D" />

            <TextView
                android:id="@+id/tvElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textColor="#17160F"
                android:text="Elapsed: 0.0s" />

            <TextView
                android:id="@+id/tvRam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textColor="#17160F"
                android:text="RAM: -- MB" />

            <TextView
                android:id="@+id/tvCpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textColor="#17160F"
                android:text="CPU: -- %" />

            <TextView
                android:id="@+id/tvGpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textColor="#17160F"
                android:text="GPU: -- %" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Output"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#8A887D" />

        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="140dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:textSize="14sp"
            android:textIsSelectable="true"
            android:textColor="#17160F"
            android:text="Nothing run yet." />

    </LinearLayout>
</ScrollView>
